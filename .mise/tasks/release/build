#!/usr/bin/env bash
#MISE description="Build the native macOS arm64 release artifacts"
set -euo pipefail

tag="${1:?release tag is required}"
if [[ ! "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.-]+)?$ ]]; then
  echo "unsupported release tag: $tag" >&2
  exit 1
fi

version="${tag#v}"
mkdir -p dist
CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go build \
  -trimpath \
  -buildvcs=false \
  -ldflags="-s -w -X github.com/ishinova/gh-user-attachments/internal/userattachments.Version=${version}" \
  -o "dist/gh-user-attachments_${tag}_darwin-arm64" \
  .

{
  echo "Third-party license notices for gh-user-attachments ${version}"
  echo
  while IFS= read -r license; do
    echo "===== ${license} ====="
    cat "$license"
    echo
  done < <(
    find third_party_licenses -type f \
      \( -name 'LICENSE*' -o -name 'LICENCE*' -o -name 'NOTICE*' -o -name 'COPYING*' \) \
      | sort
  )
} > dist/THIRD_PARTY_NOTICES.txt

(
  cd dist
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "gh-user-attachments_${tag}_darwin-arm64" THIRD_PARTY_NOTICES.txt > checksums.txt
  else
    shasum -a 256 "gh-user-attachments_${tag}_darwin-arm64" THIRD_PARTY_NOTICES.txt > checksums.txt
  fi
)
